# =============================================================================
# BookSure - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, or your own Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Authentication (Better Auth) ────────────────────────────────────────────
# Generate with: openssl rand -base64 32 (or use any 32+ char random string)
BETTER_AUTH_SECRET=replace-with-a-random-string-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of email addresses granted access to /admin
# (e.g. ADMIN_EMAILS=you@gmail.com,other@example.com)
ADMIN_EMAILS=replace-with-your-email

# ─── Email Verification ───────────────────────────────────────────────────────
# New accounts must confirm their email before they can sign in. The
# verification link is emailed using the SMTP or Resend configuration below.

# ─── Google Calendar OAuth ───────────────────────────────────────────────────
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Twilio SMS ──────────────────────────────────────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+12025551234

# ─── MTN Mobile Money (Rwanda / Africa) ──────────────────────────────────────
MTN_API_KEY=your-mtn-api-key
MTN_API_SECRET=your-mtn-api-secret

# ─── Airtel Money (Rwanda / Africa) ──────────────────────────────────────────
AIRTEL_API_KEY=your-airtel-api-key
AIRTEL_API_SECRET=your-airtel-api-secret

# ─── App URL ─────────────────────────────────────────────────────────────────
# Used for redirect URIs and booking links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# SMTP configuration for sending automated emails
# Gmail: smtp.gmail.com (use App Password, not account password)
# Outlook: smtp.office365.com
# Custom: set SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# ─── Email (Resend - Production) ──────────────────────────────────────────────
# Professional email service for production customer-facing emails
# Sign up at https://resend.com — free tier: 3,000 emails/month
# When RESEND_API_KEY is set, Resend is used instead of SMTP
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=notifications@yourdomain.com

# ─── Cron Security ───────────────────────────────────────────────────────────
# Secret token to protect cron endpoints from unauthorized access
# Generate with: openssl rand -base64 32
CRON_SECRET=your-cron-secret-token
