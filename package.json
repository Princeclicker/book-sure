{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:verify": "cross-env NODE_ENV=development tsx --env-file=.env.local scripts/verify-bos-tables.ts",
    "db:migrate:pg": "cross-env NODE_ENV=development tsx --env-file=.env.local scripts/migrate-pg.ts",
    "db:migrate:prod": "node --env-file=.env.production node_modules/drizzle-kit/bin.cjs migrate",
    "test:e2e": "cross-env NODE_ENV=development tsx scripts/e2e-bos-test.ts",
    "backfill-emails": "cross-env NODE_ENV=development tsx --env-file=.env.local scripts/send-missing-emails.ts",
    "backfill-notifications": "cross-env NODE_ENV=development tsx --env-file=.env.local scripts/send-missing-notifications.ts",
    "backfill-calendar": "cross-env NODE_ENV=development tsx --env-file=.env.local scripts/backfill-calendar.ts",
    "diagnose": "node scripts/diagnose-turbopack.js",
    "trace": "node scripts/trace-module.js",
    "check-imports": "powershell -ExecutionPolicy Bypass -File scripts/check-imports.ps1",
    "dev:verbose": "NEXT_TURBOPACK_TRACING=1 next dev",
    "dev:webpack": "next dev --webpack"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "better-auth": "^1.6.16",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "nodemailer": "^8.0.11",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "resend": "^6.12.4",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.19.0",
    "typescript": "5.7.3"
  }
}
